@startuml happy_path
title Whirlpooling batch over Kafka: idle -> start -> running -> done -> idle
skinparam shadowing false
skinparam defaultFontSize 11
skinparam maxMessageSize 300
skinparam sequenceMessageAlign left
autonumber

box "Scheduler service (backend/src/scheduling)"
  participant "scheduler_main.c" as SM
  participant "scheduler.c" as SC
  participant "machine_table.c" as TB
  participant "dispatch.c" as DP
end box
queue "Kafka\ntopic whirlpooling" as K
box "Whirlpool (whirlpooling/src)"
  participant "main.c" as WM
  participant "ledger.c" as LD
  database "whirlpooling-1.ledger" as F
  participant "whirlpooling.c" as WP
end box

== Startup ==
SM -> SC : scheduler_open("kafka:29092")
SC -> K : mk_open: subscribe to all six topics,\ngroup "scheduler", statuses only
WM -> LD : mk_ledger_open(&ledger, "whirlpooling-1.ledger", "whirlpooling", 1)
LD -> F : load (missing file = empty ledger)
WM -> K : mk_open: subscribe to "whirlpooling",\ngroup "whirlpooling-1", commands only
WM -> WP : whirlpooling_init(&whirlpool, &batches)

== Machine announces itself ==
WM -> WM : mk_ready(bus) == 1 -> announce()
WM -> K : mk_send(idle)\n{"type":"idle","machine_type":"whirlpooling","machine_id":1,...}
K -> SC : mk_poll -> on_status(idle)
SC -> TB : machine_table_apply(&table, status)\nrow whirlpooling#1: state = MK_IDLE
SC -> DP : dispatch(s, row)

== Start (from dispatch, later) ==
DP -> SC : scheduler_start(s, "whirlpooling", 1, "B-0001",\n{{"duration_s", 3600}}, 1)
SC -> K : mk_make_start + mk_param_set + mk_send\n{"type":"start","batch_id":"B-0001","params":{"duration_s":3600},...}\ntopic whirlpooling, key "1"
K -> WM : mk_poll -> on_command(start) -> handle_start()
WM -> LD : mk_ledger_lookup(&ledger, start, &status)
LD --> WM : 0 (new batch)
WM -> WM : mk_param_get(start, "duration_s", &duration) = 3600
WM -> LD : mk_ledger_accept(&ledger, start)
LD -> F : "R B-0001 <message_id> -"  (tmp + fsync + rename)
WM -> WP : whirlpooling_set_duration(&whirlpool, 3600)\nwhirlpooling_start(&whirlpool, now)
WP --> WM : WHIRLPOOLING_STARTED
WM -> K : mk_send(running B-0001)
K -> SC : on_status(running)
SC -> TB : row: MK_RUNNING, batch B-0001
SC -> DP : dispatch(s, row)

== Run (duration_s simulated seconds) ==
loop every 100 ms
  WM -> K : mk_poll(bus, 100, on_command, &c)
  WM -> WP : whirlpooling_update(&whirlpool, now)
  WP --> WM : WHIRLPOOLING_NO_CHANGE
end

== Done and idle again ==
WM -> WP : whirlpooling_update(&whirlpool, now)
WP --> WM : WHIRLPOOLING_DONE
WM -> LD : mk_ledger_record(&ledger, done)
LD -> F : "D B-0001 <message_id> -"
WM -> K : mk_send(done B-0001)
WM -> K : mk_send(idle)
K -> SC : on_status(done), on_status(idle)
SC -> TB : row: MK_DONE, then MK_IDLE
SC -> DP : dispatch(s, row) for each\n(next step of B-0001 / next batch on this machine)
@enduml
