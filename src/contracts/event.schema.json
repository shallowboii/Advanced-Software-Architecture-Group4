{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "machine_id",
    "event",
    "event_id",
    "machine_sequence",
    "snapshot"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "machine_id": {
      "type": "string",
      "pattern": "^(mash|lauter|kettle|whirlpool|unitank|filter)-[0-9]+$"
    },
    "batch_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "sim_time_h": {
      "type": "number",
      "minimum": 0
    },
    "event": {
      "enum": [
        "STARTED",
        "PHASE_COMPLETED",
        "READY_TO_TRANSFER",
        "TRANSFER_PREPARED",
        "TRANSFER_READY",
        "TRANSFER_COMMITTED",
        "TRANSFER_ABORTED",
        "STOPPED",
        "RESUMED",
        "FLUSH_REQUESTED",
        "SPOILED",
        "FLUSHED",
        "COMPLETED",
        "REJECTED",
        "SNAPSHOT"
      ]
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "machine_sequence": {
      "type": "integer",
      "minimum": 0
    },
    "snapshot": {
      "type": "object"
    }
  },
  "title": "Beer Factory event"
}
