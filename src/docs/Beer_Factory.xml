<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE nta PUBLIC '-//Uppaal Team//DTD Flat System 1.6//EN' 'http://www.it.uu.se/research/group/darts/uppaal/flat-1_6.dtd'>
<nta>
	<declaration>// Place global declarations here.

// We need this because the next machine can only keep one hot wort batch
int MAX_HOT_WORT_BATCHES = 1;

int sweet_wort_batches = 0;
int hot_wort_batches = 0;

// Lautering channels
urgent chan start_lauter;
broadcast chan done_lauter;</declaration>
	<template>
		<name>Scheduling</name>
		<declaration>clock a;</declaration>
		<location id="id0" x="0" y="0">
		</location>
		<init ref="id0"/>
	</template>
	<template>
		<name x="5" y="5">Mashing</name>
		<declaration>// Place local declarations here.
clock a;</declaration>
		<location id="id1" x="0" y="0">
		</location>
		<init ref="id1"/>
	</template>
	<template>
		<name>Lautering</name>
		<declaration>clock x;
const int T_LAUTER = 120;</declaration>
		<location id="id2" x="-34" y="-25">
			<name x="-44" y="-59">Idle</name>
		</location>
		<location id="id3" x="161" y="-25">
			<name x="151" y="-59">Lautering</name>
			<label kind="invariant" x="151" y="-8">x &lt;= 60</label>
		</location>
		<init ref="id2"/>
		<transition id="id4">
			<source ref="id2"/>
			<target ref="id3"/>
			<label kind="synchronisation" x="-16" y="-42">start_lauter?</label>
			<label kind="assignment" x="-16" y="-25">x=0</label>
		</transition>
		<transition id="id5">
			<source ref="id3"/>
			<target ref="id2"/>
			<label kind="guard" x="76" y="34">x == T_LAUTER</label>
			<label kind="synchronisation" x="76" y="51">done_lauter!</label>
			<nail x="68" y="144"/>
		</transition>
	</template>
	<template>
		<name>Boiling</name>
		<declaration>clock c;

void start_boiling() {
    c = 0;
    sweet_wort_batches--;
}

void stop_boiling() {
    hot_wort_batches++;
}</declaration>
		<location id="id6" x="-440" y="-178">
			<name x="-459" y="-212">Wait</name>
		</location>
		<location id="id7" x="-102" y="-178">
			<name x="-110" y="-212">Boil</name>
			<label kind="invariant" x="-127" y="-161">c &lt;= 60</label>
		</location>
		<init ref="id6"/>
		<transition id="id8">
			<source ref="id7"/>
			<target ref="id6"/>
			<label kind="synchronisation" x="-340" y="-68">done_boiling!</label>
			<label kind="assignment" x="-340" y="-51">stop_boiling();</label>
			<nail x="-289" y="-68"/>
		</transition>
		<transition id="id9">
			<source ref="id6"/>
			<target ref="id7"/>
			<label kind="guard" x="-399" y="-255">sweet_wort_batches &gt;= 0
hot_wort_batches &lt; MAX_HOT_WORT_BATCHES</label>
			<label kind="synchronisation" x="-382" y="-272">start_boiling?</label>
			<label kind="assignment" x="-382" y="-213">start_boiling();</label>
		</transition>
	</template>
	<template>
		<name>Whirlpooling</name>
		<declaration>clock a;</declaration>
		<location id="id10" x="0" y="0">
		</location>
		<init ref="id10"/>
	</template>
	<template>
		<name>Tank</name>
		<location id="id11" x="0" y="0">
		</location>
		<init ref="id11"/>
	</template>
	<template>
		<name>Filtering</name>
		<declaration>clock a;
</declaration>
		<location id="id12" x="0" y="0">
		</location>
		<init ref="id12"/>
	</template>
	<system>// Place template instantiations here.
Process = Template();
// List one or more processes to be composed into a system.
system Process;

tank1 = Tank()
tank2 = Tank()</system>
	<queries>
		<query>
			<formula/>
			<comment/>
		</query>
	</queries>
</nta>
