// We need this because the next machine can only keep one hot wort batch
const int MAX_HOT_WORT_BATCHES = 1;
const int MAX_TANKS = 24;

// Lautering channels
urgent chan start_lauter;
broadcast chan done_lauter;

int chosen_tank = -1;
int finished_tanks = 0;

// Batch counters between stages
int sweet_wort_batches = 0, hot_wort_batches = 0, cold_wort_batches = 0;
int green_beer_batches = 0, beer_batches = 0;

// Channels (for scheduling)
urgent chan start_mashing, start_boiling, start_whirlpool, start_filtering;
chan done_mashing, done_boiling, done_whirlpool, done_maturation_fermentation, done_filtering;
broadcast chan start_maturation_fermentation;

// Finished batches?
int started_batches = 0;
const int MAX_BATCHES = 50;
int[0, MAX_BATCHES] finished_batches = 0;


bool is_mashing = false;

//Tank counter
int[0,1] tanks_status[MAX_TANKS];                // 0 = free, 1 = busy
int[0,MAX_TANKS] free_tank = MAX_TANKS;         // counter of free tanks

const int TIME_LEFT_LIMIT = 6;
const int FERMENTATION_TIME = 120;
const int MATURATION_TIME = 216;

// WHIRLPOOLING things
const int MAX_WHIRLPOOLED_BATCHES = 1;

//Checking time left of tanks
bool almost_done[MAX_TANKS];

bool any_almost_done() {
    int i;
    for (i=0; i &lt; MAX_TANKS; i++) {
        if(almost_done[i])
            return true; 
    }
return false;
}</declaration>
