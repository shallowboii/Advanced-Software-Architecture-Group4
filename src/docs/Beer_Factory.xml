	<template>
		<name>Whirlpooling</name>
		<parameter>int &amp;unwhirlpooled_beer_batch, int &amp;whirlpooled_beer_batch</parameter>
		<declaration>clock a;

// Same time unit as the rest of the model
const int T_SPINUP   = 1;   // motor reaches whirlpool speed
const int T_WHIRL    = 15;  // whirlpool spinning time
const int T_SPINDOWN = 1;   // motor stops

const int SPEED_WHIRL = 100;
int spin = 0;               // current motor speed (0 = stopped)

void reset() {
    a = 0;
}

void start_whirlpooling() {
    unwhirlpooled_beer_batch--;
}

void spinup() {
    spin = SPEED_WHIRL;
}

void spindown() {
    spin = 0;
}

void stop_whirlpooling() {
    whirlpooled_beer_batch++;
}</declaration>
