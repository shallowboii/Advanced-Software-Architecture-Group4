int finished_tanks = 0;

// Batch counters between stages
int sweet_wort_batches = 0, hot_wort_batches = 0, cold_wort_batches = 0;
int green_beer_batches = 0, beer_batches = 0;

// Channels (for scheduling)
urgent chan start_mashing, start_boiling, start_whirlpool, start_filtering;
chan done_mashing, done_boiling, done_whirlpool, done_fermentation, done_filtering;
broadcast chan start_maturation_fermentation;

// Finished batches?
int started_batches = 0;
const int MAX_BATCHES = 50;
int[0, MAX_BATCHES] finished_batches = 0;</declaration>
