	<declaration>// Place global declarations here.

// Buffer capacities between brewhouse stages
const int MAX_WORT_BATCHES = 1;
const int MAX_SWEET_WORT_BATCHES = 1;
const int MAX_HOT_WORT_BATCHES = 1;
const int MAX_CLARIFIED_WORT_BATCHES = 1;
const int MAX_TANKS = 24;

// Stage durations (hours)
const int T_MASHING = 2;        // FR-10.1
const int T_LAUTER = 2;
const int T_BOILING = 1;        // FR-10
const int T_WHIRLPOOLING = 1;   // FR-10.4
const int T_FILTERING = 4;
const int FERMENTATION_TIME = 120;
const int MATURATION_TIME = 216;
const int TIME_LEFT_LIMIT = T_MASHING + T_LAUTER + T_BOILING + T_WHIRLPOOLING;

// Channels (for scheduling)
urgent chan start_mashing, start_lauter, start_boiling, start_whirlpool, start_filtering;
chan done_mashing, done_lauter, done_boiling, done_whirlpool;
chan start_maturation_fermentation[MAX_TANKS];
broadcast chan done_filtering;
urgent broadcast chan asap;

// Batch counters between stages
int wort_batches = 0;
int sweet_wort_batches = 0, hot_wort_batches = 0, clarified_wort_batches = 0;
int green_beer_batches = 0, beer_batches = 0;

// Machine readiness flags
bool is_mashing = false;
bool lautering_ready = true;
bool boiling_ready = true;
bool whirlpooling_ready = true;
bool filtering_ready = true;

// Tank status and counters
int[0,1] tanks_status[MAX_TANKS];                // 0 = free, 1 = busy
int[0,MAX_TANKS] free_tank = MAX_TANKS;          // counter of free tanks
bool almost_done[MAX_TANKS];

// Batches between the start of mashing and entering a tank
int[0,MAX_TANKS] in_brewhouse = 0;

int almost_done_count() {
    int i, n = 0;
    for (i = 0; i &lt; MAX_TANKS; i++) {
        if (almost_done[i])
            n++;
    }
    return n;
}

// A new batch may start only if a tank will be free when it leaves the brewhouse
bool tank_for_new_batch() {
    return in_brewhouse &lt; free_tank + almost_done_count();
}

int first_free_tank() {
    int i;
    for (i = 0; i &lt; MAX_TANKS; i++) {
        if (!tanks_status[i])
            return i;
    }
    return -1;
}

bool any_tank_ready() {
    int i;
    for (i = 0; i &lt; MAX_TANKS; i++) {
        if (!tanks_status[i])
            return true;
    }
    return false;
}</declaration>
