	<template>
		<name>Boiling</name>
		<parameter>int &amp;sweet_wort_batches, int &amp;hot_wort_batches</parameter>
		<declaration>clock c;

void reset() {
    c = 0;
}

void start_boiling(int* sweet_wort_batches) {
    sweet_wort_batches--;
}

void stop_boiling(int* hot_wort_batches) {
    hot_wort_batches++;
}</declaration>
