		<declaration>clock c;

const int T_BOILING = 1; // hours (FR-10)

void reset() {
    c = 0;
}

void take_sweet_wort() {
    sweet_wort_batches--;
}

void make_hot_wort() {
    hot_wort_batches++;
}</declaration>
