	<template>
		<name>Tank</name>
		<parameter>int tank_idx, int &amp;cold_wart_batches, int &amp;green_beer_batches, int&amp; beer_batches</parameter>
		<declaration>clock c;

void reset() {
    c = 0;
}

void start_fermentation() {
    cold_wort_batches--;
}

void stop_fermentation() {
    green_beer_batches++;
}

void start_maturation() {
    green_beer_batches--;
}

void stop_maturation() {
    beer_batches++;
}

void set_tank_busy() {
    tanks_status[tank_idx] = 1;
}

void set_tank_free() {
    tanks_status[tank_idx] = 0;
}</declaration>
