        },
        "kafka": {
          "condition": "service_started"
        }
      },
      "restart": "unless-stopped"
    },
    "filter-0": {
      "build": {
        "context": ".",
        "dockerfile": "src/machine/Dockerfile"
      },
      "image": "beerfactory-machine:local",
      "hostname": "filter-0",
      "environment": {
        "MQTT_URL": "tcp://rabbitmq:1883",
        "MQTT_USERNAME": "beerfactory",
        "MQTT_PASSWORD": "development-only",
        "KAFKA_BROKERS": "kafka:9092",
        "TIME_SCALE": "2",
        "MACHINE_TYPE": "filter",
        "MACHINE_ID": "filter-0",
        "SOCKET_PATH": "/tmp/machine.sock",
        "FLUSH_H": "0.1"
      },
      "depends_on": {
        "rabbitmq": {
          "condition": "service_healthy"
        },
        "kafka": {
          "condition": "service_started"
        }
      },
      "restart": "unless-stopped"
    }
  },
  "volumes": {
    "postgres-data": {},
    "rabbitmq-data": {},
    "kafka-data": {}
  }
}
