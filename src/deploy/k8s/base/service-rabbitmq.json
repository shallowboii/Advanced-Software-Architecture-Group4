{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "rabbitmq"
  },
  "spec": {
    "selector": {
      "app": "rabbitmq"
    },
    "ports": [
      {
        "name": "main",
        "port": 1883,
        "targetPort": 1883
      }
    ],
    "clusterIP": "None",
    "publishNotReadyAddresses": true
  }
}
