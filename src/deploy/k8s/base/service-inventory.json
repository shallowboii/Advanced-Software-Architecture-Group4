{
  "apiVersion": "v1",
  "kind": "Service",
  "metadata": {
    "name": "inventory"
  },
  "spec": {
    "selector": {
      "app": "inventory"
    },
    "ports": [
      {
        "name": "main",
        "port": 8081,
        "targetPort": 8081
      }
    ],
    "clusterIP": "None",
    "publishNotReadyAddresses": true
  }
}
